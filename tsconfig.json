{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src",
    "test",
    "bench",
    "scripts",
    // Spelled as a glob on purpose: TypeScript drops directories whose name
    // starts with a dot when it expands a bare directory entry, so listing
    // `docs/.vitepress` alone silently type-checked none of the site's code.
    "docs/.vitepress/**/*.ts",
    "eslint.config.mjs",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
