{
  "description": "At-rules that configure a resource or page box rather than an element keep their authored lengths",
  "options": {
    "defaultProfile": "app",
    "libraries": false,
    "profiles": {
      "app": { "designWidth": 375, "fluid": { "minWidth": 320, "maxWidth": 480 } },
      "pc": { "designWidth": 1440, "fluid": { "minWidth": 1024, "maxWidth": 1920 }, "query": "(min-width: 768px)" }
    }
  }
}
