{
  "description": "orientation does not hide a provable width route",
  "options": {
    "defaultProfile": "app",
    "libraries": false,
    "profiles": {
      "app": {
        "designWidth": 750,
        "fluid": { "minWidth": 320, "maxWidth": 600 }
      },
      "pc": {
        "designWidth": 1440,
        "fluid": { "minWidth": 1024, "maxWidth": 1920 }
      }
    },
    "routes": [{ "profile": "pc", "media": { "minWidth": 1024 } }]
  }
}
